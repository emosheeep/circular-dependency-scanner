{
  "name": "circular-dependency-scanner",
  "type": "module",
  "version": "3.0.1",
  "packageManager": "pnpm@11.20.0",
  "description": "Out-of-box and zero configuration circular dependencies detector, with both JavaScript API and Command Line Tool.",
  "author": "情绪羊 <emosheep@qq.com>",
  "license": "MIT",
  "repository": {
    "type": "github",
    "url": "https://github.com/emosheeep/circular-dependency-scanner"
  },
  "keywords": [
    "circular",
    "scanner",
    "detector",
    "circles",
    "cyclic",
    "ast",
    "javascript",
    "ecmascript",
    "circular-dependency",
    "cli",
    "napi-rs",
    "rust",
    "wasm"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "ds": "dist/cli.js"
  },
  "files": [
    "CHANGELOG.md",
    "README.md",
    "README.zh_CN.md",
    "dist"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "prepare": "husky",
    "prepublishOnly": "npm run lint:check && npm run format:check && npm test && npm run build",
    "lint": "oxlint --fix --deny-warnings .",
    "lint:check": "oxlint --deny-warnings .",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "build": "npm run build:wasm && rslib build",
    "build:wasm": "wasm-pack build --release -t bundler -d wasm",
    "watch": "npm run build:wasm && rslib build --watch",
    "changeset": "changeset",
    "versions": "changeset version",
    "test": "vitest",
    "test:watch": "vitest --watch"
  },
  "dependencies": {
    "@ast-grep/napi": "^0.45.0",
    "@vue/compiler-sfc": "^3.5.40",
    "commander": "^15.0.0",
    "get-tsconfig": "^4.14.1",
    "listr2": "^11.0.0",
    "minimatch": "^10.2.6",
    "node-cleanup": "2.1.2",
    "update-notifier": "7.3.1",
    "zx": "8.8.5"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@rslib/core": "^0.23.2",
    "@types/node": "^26.1.2",
    "husky": "9.1.7",
    "lint-staged": "^17.3.0",
    "oxfmt": "0.62.0",
    "oxlint": "1.77.0",
    "typescript": "7.0.2",
    "vitest": "^4.1.10"
  }
}
